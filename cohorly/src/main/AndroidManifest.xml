<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Native crash reporting (ADR-0020). Does nothing unless the
             persisted crash config enables it. -->
        <provider
            android:name="com.cohorly.android.crash.CohorlyCrashProvider"
            android:authorities="${applicationId}.cohorly-crash"
            android:exported="false"
            android:initOrder="1000" />
    </application>
</manifest>
